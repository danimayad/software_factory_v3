{
  "permissions": {
    "allow": [
      "Bash(bash scripts/check.sh)",
      "Bash(python3 scripts/*)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "git fetch *",
      "git pull *",
      "git push *",
      "gh *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_paths.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gates_on_stop.py\"",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
